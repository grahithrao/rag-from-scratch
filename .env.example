# ============================================================
# RAG From Scratch — environment configuration
# Copy to .env and fill in your key:  cp .env.example .env
# ============================================================

# ---- Groq LLM (REQUIRED for answer generation) -------------
# Create a free key at https://console.groq.com/keys
GROQ_API_KEY=your_api_key_here

# Chat model served by Groq.
GROQ_MODEL=openai/gpt-oss-120b

# Low temperature keeps answers close to the retrieved text.
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60

# ---- Embeddings (runs locally, no API key needed) ----------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# ---- Chunking ----------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ---- Retrieval ----------------------------------------------
TOP_K=5
# Cosine-distance ceiling (0-2). Lower = stricter relevance filter.
MAX_DISTANCE=1.15

# ---- Chat memory --------------------------------------------
# User/assistant pairs carried into the next question.
MAX_HISTORY_TURNS=4

# ---- Storage -------------------------------------------------
CHROMA_COLLECTION=rag_from_scratch
MAX_UPLOAD_MB=25

# ---- Server ---------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8001
API_BASE_URL=http://127.0.0.1:8001
CORS_ORIGINS=*
